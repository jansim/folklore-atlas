{
  "name": "folklore-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Folklore Atlas: folktales from the trilogy Annotated Folktales as wisps over a globe that unrolls into a flat map",
  "scripts": {
    "build": "npm run build:world && npm run build:data && npm run build:site",
    "build:world": "node scripts/build-world.js",
    "build:data": "node scripts/build-data.js",
    "build:site": "node scripts/build-site.js",
    "dev": "node scripts/build-site.js --watch --serve",
    "serve": "node scripts/build-site.js --serve",
    "test": "node --test",
    "test:e2e": "playwright test",
    "perf": "node perf/measure.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2",
    "topojson-simplify": "3.0.3"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "type": "module"
}
